# ==============================================================================
# Environment Configuration for AI Customer Support Agent (AppleSupport)
# ==============================================================================

# Pipeline Model Provider: Google AI Studio
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here
PIPELINE_MODEL=gemini-2.5-flash

# LLM-as-Judge Provider: Groq
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
JUDGE_MODEL=llama-3.3-70b-versatile

# Target Brand (Locked to AppleSupport)
TARGET_BRAND=AppleSupport

# Paths (defaults match repo structure)
RAW_DATA_PATH=data/raw/twcs.csv
SUBSAMPLE_DATA_PATH=data/subsample/applesupport_threads_5k.jsonl
GOLD_DATA_PATH=data/gold/gold_eval_200.jsonl
